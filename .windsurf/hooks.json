{
  "hooks": {
    "pre_user_prompt": [
      {
        "command": "npx --yes @coree-ai/coree@0.14.0 inject --type prompt --budget 8000",
        "show_output": true
      }
    ],
    "post_cascade_response": [
      {
        "command": "npx --yes @coree-ai/coree@0.14.0 inject --type stop"
      }
    ]
  }
}
